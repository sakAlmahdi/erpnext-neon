# ---------------------------------------------------------------------------
# ERPNext on Coolify — environment variables
# Copy these into Coolify's "Environment Variables" panel for the resource.
# Sized for a 2 vCPU / 4 GB host.
# ---------------------------------------------------------------------------

# --- Custom image you built and pushed (see README-COOLIFY.md) -------------
# Both are REQUIRED: the compose file has no fallback on purpose, so a missing
# value fails loudly instead of silently deploying stock ERPNext.
CUSTOM_IMAGE=ghcr.io/sakalmahdi/erpnext-neon
CUSTOM_TAG=develop

PULL_POLICY=always
RESTART_POLICY=unless-stopped

# --- Host port (3110-3190 range) -------------------------------------------
# nginx inside the image listens on 8080 (hardcoded in its config template),
# so the container port cannot change. This publishes it on a host port
# instead, giving direct access at https://erp.neon-dev.dev
HOST_PORT=3110

# --- Site name --------------------------------------------------------------
# No domain yet, so the site is reached by IP:PORT. nginx matches the site by
# the Host header, and a request to http://1.2.3.4:3110 sends "1.2.3.4:3110"
# as that header -- which would NOT match a site named erp.neon-dev.dev.
#
# Two consequences of going domain-less:
#   1. SITE_NAME below must be the value you actually browse to.
#   2. FRAPPE_SITE_NAME_HEADER is pinned to it, so nginx serves this one site
#      regardless of how it is addressed.
#
# Coolify runs on the same host as the SQL Server used by the .NET API.
# ERPNext's own MariaDB stays container-internal (no host port), so there is
# no clash with SQL Server on 1433.
SITE_NAME=erp.neon-dev.dev

# Scheme and host used to build absolute links (emails, password resets).
# No domain => plain http, and the port MUST be included or every emailed
# link points at port 80 and fails.
#   now:   SITE_SCHEME=http   SITE_HOST=178.18.249.38:3110
#   later: SITE_SCHEME=https  SITE_HOST=erp.neon-dev.dev
SITE_SCHEME=https
SITE_HOST=erp.neon-dev.dev

# When you later attach the domain, change SITE_NAME to erp.neon-dev.dev and
# run:  bench --site <old> set-config host_name https://erp.neon-dev.dev
# Renaming an existing site needs `bench rename-site`, so picking the final
# name now saves that step.

# Login password for the "Administrator" user. Change before first deploy:
# the site is created with this value and it is not re-read afterwards.
ADMIN_PASSWORD=change-me-strong

# --- Database ---------------------------------------------------------------
# MariaDB root password. Used to initialise the DB and to create the site.
# Changing it AFTER the db-data volume exists will break startup — the volume
# keeps the original password.
DB_PASSWORD=change-me-strong-too

# --- Migrations -------------------------------------------------------------
# Runs `bench migrate` on each deploy, before backend starts. Required
# whenever the image ships new code. Note: frappe_docker documents a
# MIGRATE_SITES variable, but its entrypoints do not read it — hence the
# explicit `migrate` service in the compose file.
RUN_MIGRATIONS=true

# --- ERPNext site settings --------------------------------------------------
# developer_mode=1 lets the UI write DocType changes to disk inside the
# container. Slower, and those edits vanish on redeploy. Keep 0.
DEVELOPER_MODE=0

# Server Scripts run user-authored Python inside the app. This is a
# remote-code-execution surface — enable only if you actually need it.
SERVER_SCRIPT_ENABLED=0

# --- Memory: no hard caps -----------------------------------------------------
# Container memory limits were deliberately REMOVED: services take what they
# need from the host instead of being boxed in.
#
# The trade-off you accepted: a Docker limit is a ceiling, not a reservation.
# With no ceiling, nothing stops one container from consuming the host's RAM,
# and the kernel's OOM killer then picks the LARGEST process -- which on this
# shared host may be SQL Server, taking the whole platform down with it.
#
# Two mitigations are in place:
#   1. oom_score_adj in the compose file makes every ERPNext container a more
#      attractive OOM target than SQL Server, so ERPNext dies first.
#   2. The two allocations that never shrink are still bounded below.

# MariaDB's buffer pool is allocated up front and never returned to the OS.
# Raise if the DB is slow; LOWER THIS FIRST if the host starts swapping.
DB_BUFFER_POOL=1G

# Cache eviction ceiling. Without it the cache grows until something dies.
REDIS_CACHE_MAXMEMORY=512mb

# --- Gunicorn (2 vCPU) ------------------------------------------------------
# The (2 x cores) + 1 formula would give 5, which starves the background
# workers and MariaDB on a 2-core box. 2 gthread workers x 4 threads is the
# right trade here; raise WORKERS only when you add cores.
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# --- nginx / reverse proxy --------------------------------------------------
# Coolify terminates TLS and forwards plain HTTP, so trust its forwarded
# header to recover the real client IP (used by rate limiting and audit logs).
UPSTREAM_REAL_IP_ADDRESS=0.0.0.0
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
UPSTREAM_REAL_IP_RECURSIVE=off
PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m

# nginx matches the site by this value. Set it explicitly to the domain --
# Coolify does not expand a variable used as another variable's default, so
# leaving it empty here would have passed the literal text "$SITE_NAME".
FRAPPE_SITE_NAME_HEADER=erp.neon-dev.dev
