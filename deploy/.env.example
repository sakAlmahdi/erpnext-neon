# ---------------------------------------------------------------------------
# ERPNext on Coolify — environment variables
# Copy these into Coolify's "Environment Variables" panel for the resource.
# ---------------------------------------------------------------------------

# --- Custom image you built and pushed (see README-COOLIFY.md) -------------
CUSTOM_IMAGE=ghcr.io/sakalmahdi/erpnext-neon
CUSTOM_TAG=develop

# Use "always" if you re-push the same tag; "missing" to avoid refetching.
PULL_POLICY=always
RESTART_POLICY=unless-stopped

# --- Site -------------------------------------------------------------------
# MUST match the domain you attach in Coolify, otherwise nginx cannot
# resolve the site from the Host header and you get "Site does not exist".
SITE_NAME=erp.example.com

# Login for the "Administrator" user.
ADMIN_PASSWORD=change-me-strong

# --- Database ---------------------------------------------------------------
# MariaDB root password. Used both to init the DB and to create the site.
DB_PASSWORD=change-me-strong-too

# --- Gunicorn tuning --------------------------------------------------------
# Formula: (2 x CPU cores) + 1
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# --- nginx / proxy ----------------------------------------------------------
# Coolify terminates TLS and forwards; trust its forwarded-for header.
UPSTREAM_REAL_IP_ADDRESS=0.0.0.0
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
UPSTREAM_REAL_IP_RECURSIVE=off
PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m

# Leave empty to resolve the site by Host header (recommended when the
# domain matches SITE_NAME). Set it to SITE_NAME to force a single site.
FRAPPE_SITE_NAME_HEADER=
